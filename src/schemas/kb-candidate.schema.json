{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vireact.io/schema/kb-candidate.schema.json",
  "title": "Vireact knowledge-base candidate (backend copy)",
  "description": "Copied from Bascosta2/vireact-research schema/kb-candidate.schema.json, plus the review agent's `review` object and an optional per-evidence `source_tier`. The backend validates against this copy, never the repo's, so an agent can't loosen it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_date", "type", "title", "insight", "actionable_rule", "topics", "platforms", "evidence", "source_tier", "confidence", "freshness"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "type": { "enum": ["hook_pattern", "story_structure", "retention_tactic", "platform_algorithm", "benchmark_stat", "ugc_method", "script_structure", "case_study", "trend", "audio_trend", "caption_tactic"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 90 },
    "insight": { "type": "string", "minLength": 1 },
    "actionable_rule": { "type": "string", "minLength": 1 },
    "example": { "type": "string" },
    "topics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["hook", "pacing", "caption", "audio", "views", "advanced_analytics", "general"] } },
    "platforms": { "type": "array", "uniqueItems": true, "items": { "enum": ["tiktok", "reels", "shorts"] } },
    "niches": { "type": "array", "items": { "type": "string" } },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string" },
          "sample_size": { "type": ["number", "string", "null"] },
          "period": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "minLength": 8 },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "published_date": { "type": "string" },
          "quote": { "type": "string" },
          "source_tier": { "enum": [1, 2, 3] }
        }
      }
    },
    "source_tier": { "enum": [1, 2, 3] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshness": { "enum": ["evergreen", "current"] },
    "agent_notes": { "type": "string" },
    "review": {
      "type": "object",
      "required": ["verdict", "score"],
      "properties": {
        "verdict": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "verified_sources": { "type": "number" },
        "checks": { "type": "object" },
        "reviewer_notes": { "type": "string" }
      }
    }
  }
}
