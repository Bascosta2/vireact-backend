# Secret key for admin data ingestion endpoints — generate a strong random string.
ADMIN_API_KEY=

# Optional: path to yt-dlp binary (default: yt-dlp on PATH). Required for TikTok / YouTube / Instagram URL paste unless using the Docker image.
# YT_DLP_PATH=yt-dlp
# YT_DLP_TIMEOUT_MS=600000
# SOCIAL_VIDEO_MAX_BYTES=209715200

# Mailchimp — powers the /viral-hooks PDF lead-gen funnel.
# Leave MAILCHIMP_ENABLED=false for dev: the /api/subscribe endpoint will log
# submissions to the server console and still redirect users to the thank-you
# page, so the page can be tested end-to-end before creds are wired.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_ENABLED=false
# Non-production only: the Mailchimp call is skipped unless this is also true.
MAILCHIMP_DEV_ENABLED=false

# ── Local development isolation (.env.local overrides .env outside production) ──
# Mongo guard: outside production the server refuses to start when DB_NAME (or the DB_URL path
# database) matches this regex. Prod and dev share one Atlas host, so names are compared, not hosts.
PROD_DB_NAME_PATTERN=^prod$
# Deliberate escape hatch for the guard above. Never set in production or by default.
# ALLOW_PROD_DB_IN_DEV=false
# Mongoose autoIndex/autoCreate. Keep false; create indexes with `node scripts/ensure-indexes.js --apply`.
MONGO_AUTO_INDEX=false
# Dev-only: reroute every outgoing email to this address (ignored when NODE_ENV=production).
EMAIL_DEV_OVERRIDE_TO=
# Local QStash: values printed by `npm run qstash:dev`. BACKEND_URL must be reachable by QStash.
# QSTASH_URL=http://127.0.0.1:8080
# BACKEND_URL=http://localhost:5000
# Twelve Labs dev user index (vireact-user-dev) — never the production user index locally.
# TWELVELABS_USER_INDEX=
# Stripe test mode: sk_test_/pk_test_ keys, test price ids, and the whsec_ printed by `npm run stripe:listen`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PREMIUM=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_ENTERPRISE=price_...

# ── Funnel V2 ──
# 64 random bytes, hex. Use a different value per environment.
REFRESH_TOKEN_PEPPER=
FUNNEL_V2_ENABLED=false
TRIAL_BILLING_ENABLED=false
LIBRARY_ENABLED=false
LIFECYCLE_EMAILS_ENABLED=false
USE_THIS_HOOK_ENABLED=false
# legacy_free | card_trial
NEW_USER_ACCESS_MODEL=legacy_free
TRIAL_DAYS=7
TRIAL_VIDEO_LIMIT=5
TRIAL_CHAT_MESSAGE_LIMIT=60
# Hook rewriter (plan §6.6): free rewrites per quiz session, anonymous per-IP daily cap, entitled per-user daily cap.
HOOK_REWRITE_PER_SESSION=1
HOOK_REWRITE_ANON_PER_IP_PER_DAY=5
HOOK_REWRITE_ENTITLED_PER_DAY=50
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
