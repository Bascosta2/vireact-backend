# Secret key for admin data ingestion endpoints — generate a strong random string.
ADMIN_API_KEY=
# Owner console at <api>/admin/videos (every user's videos and outputs). Sign-in: ADMIN_API_KEY.
# The console stays off until both are set.
# 32+ random characters; changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Optional: path to yt-dlp binary (default: yt-dlp on PATH). Required for TikTok / YouTube / Instagram URL paste unless using the Docker image.
# YT_DLP_PATH=yt-dlp
# YT_DLP_TIMEOUT_MS=600000
# SOCIAL_VIDEO_MAX_BYTES=209715200

# Mailchimp — powers the /viral-hooks PDF lead-gen funnel.
# Leave MAILCHIMP_ENABLED=false for dev: the /api/subscribe endpoint will log
# submissions to the server console and still redirect users to the thank-you
# page, so the page can be tested end-to-end before creds are wired.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_ENABLED=false
# Non-production only: the Mailchimp call is skipped unless this is also true.
MAILCHIMP_DEV_ENABLED=false

# ── Local development isolation (.env.local overrides .env outside production) ──
# Mongo guard: outside production the server refuses to start when DB_NAME (or the DB_URL path
# database) matches this regex. Prod and dev share one Atlas host, so names are compared, not hosts.
PROD_DB_NAME_PATTERN=^prod$
# Deliberate escape hatch for the guard above. Never set in production or by default.
# ALLOW_PROD_DB_IN_DEV=false
# Mongoose autoIndex/autoCreate. Keep false; create indexes with `node scripts/ensure-indexes.js --apply`.
MONGO_AUTO_INDEX=false
# Dev-only: reroute every outgoing email to this address (ignored when NODE_ENV=production).
EMAIL_DEV_OVERRIDE_TO=
# Local QStash: values printed by `npm run qstash:dev`. BACKEND_URL must be reachable by QStash.
# QSTASH_URL=http://127.0.0.1:8080
# BACKEND_URL=http://localhost:5000
# Twelve Labs dev user index (vireact-user-dev) — never the production user index locally.
# TWELVELABS_USER_INDEX=
# Stripe test mode: sk_test_/pk_test_ keys, test price ids, and the whsec_ printed by `npm run stripe:listen`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PREMIUM=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_ENTERPRISE=price_...
# Older price ids existing subscribers are still on (comma-separated), e.g. Pro at $19 before $19.99.
# STRIPE_LEGACY_PRICE_IDS_PRO=price_...
# STRIPE_LEGACY_PRICE_IDS_PREMIUM=

# ── Funnel V2 ──
# 64 random bytes, hex. Use a different value per environment.
REFRESH_TOKEN_PEPPER=
FUNNEL_V2_ENABLED=false
# Free trial of a paid plan via Stripe Checkout. On unless set to false.
TRIAL_BILLING_ENABLED=true
# Promo codes (Settings > Promo code; codes live in src/config/promo-codes.js: skyrocket, goat).
# Comma list of codes to switch off, e.g. goat. Plans already granted stay.
PROMO_CODES_DISABLED=
# Total redemption cap per code, e.g. goat=25,skyrocket=500. Unset = no cap.
PROMO_CODE_LIMITS=
LIBRARY_ENABLED=false
# Editor tab private beta: false hides the editor from everyone except EDITOR_BETA_EMAILS (comma-separated account emails).
EDITOR_ENABLED=false
EDITOR_BETA_EMAILS=
LIFECYCLE_EMAILS_ENABLED=false
USE_THIS_HOOK_ENABLED=false
# legacy_free | card_trial
NEW_USER_ACCESS_MODEL=legacy_free
TRIAL_DAYS=7
TRIAL_VIDEO_LIMIT=5
TRIAL_CHAT_MESSAGE_LIMIT=60
# Hook rewriter (plan §6.6): free rewrites per quiz session, anonymous per-IP daily cap, entitled per-user daily cap.
HOOK_REWRITE_PER_SESSION=1
HOOK_REWRITE_ANON_PER_IP_PER_DAY=5
HOOK_REWRITE_ENTITLED_PER_DAY=50
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# AI observability (src/lib/ai-tracking.js): every OpenAI / Twelve Labs call goes to PostHog as $ai_generation
# (needs POSTHOG_KEY) and is stored for the admin panel "AI responses" tab (30 days, reviewed ones kept).
# POSTHOG_AI_PRIVACY_MODE=false       # true = don't send prompts/outputs to PostHog (tokens, cost, latency still sent)
# AI_RESPONSE_STORE=true              # false = don't store calls in Mongo
# AI_MODEL_PRICES=                    # optional JSON, USD per 1M tokens: {"gpt-6-luna":{"input":0.2,"output":1.6,"cachedInput":0.02}}

# Learning engine (src/service/learning, docs/learning-engine/PLAN.md). Daily QStash job:
# node scripts/learning/create-schedule.js --apply ; check data with node scripts/learning/report.js
# LEARNING_ENABLED=false              # true = the daily job runs (backfill, collect, label, report card)
# LEARNING_PROVIDER=                  # public data provider adapter name (brightdata); unset = no public collection
# BRIGHTDATA_API_KEY=                 # Bright Data API key (control panel > account settings); billed per record
# LEARNING_DAILY_RECORDS=2000         # provider records per day (spending cap)
# LEARNING_LABEL_LIMIT=2000           # videos labelled by the niche/format classifier per day
# LEARNING_TRACK_SHARE=0.1            # share of older/back-catalog videos re-checked for 6 months (young search finds always are)
# LEARNING_DEEP_DAILY=100             # public videos deep-analyzed per day (measured cuts + Twelve Labs scenes/transcript); 0 = off
# LEARNING_DEEP_CONCURRENCY=3         # deep analyses at once (Twelve Labs is shared with users' uploads)
# LEARNING_DEEP_MAX_SEC=180           # longest public video worth deep-analyzing
# LEARNING_DEEP_MAX_AGE_DAYS=365      # only deep-analyze videos posted within this many days (0 = any age)
# LEARNING_LANGUAGES=en               # deep-analysis pairs stay within these caption languages (comma list; empty = any)
# LEARNING_COMMENT_LIMIT=300          # videos whose top comments get intent labels per day (0 = off)
# LEARNING_HALF_LIFE_DAYS=120         # training weight halves for every this many days since posting
# LEARNING_MODEL=true                 # false = skip the daily matrix-engine training
# LEARNING_MEASURE_UPLOADS=true       # false = don't measure users' uploads (cuts, picture, rhythm, hook frames)

# Autonomous research ingest (src/service/research-ingest, SLASH_DOC "Autonomous research ingest").
# RESEARCH_REPO_TOKEN=                # GitHub fine-grained token: repo Bascosta2/vireact-research only, Contents read-only
# RESEARCH_INGEST_ENABLED=false       # true = the QStash webhook and scripts/research/pull-and-ingest.js --apply may write
# RESEARCH_MIN_SCORE=75               # minimum review-agent score
# RESEARCH_DAILY_CAP=30               # max research docs ingested per UTC day
# RESEARCH_MAX_SHARE=0.35             # research docs never exceed this share of all knowledgebases docs
# RESEARCH_RETRIEVAL_CAP=4            # max research docs in any one retrieval result list ("off" disables)
# RESEARCH_REPO=Bascosta2/vireact-research

# ─── AI models (src/config/ai-models.js). All optional; defaults shown. ───
# AI_MODEL_STRUCTURED=gpt-6-luna      # analyzers, scene/tag/KB jobs
# AI_MODEL_WRITER=gpt-6.1-terra       # chat replies, Scripts tab
# AI_MODEL_CLASSIFIER=gpt-6-luna      # chat intent
# AI_MODEL_EMBEDDING=text-embedding-3-large   # changing this requires re-embedding the knowledge base
# AI_MODEL_VIDEO=pegasus1.6           # Twelve Labs scene breakdown + transcript
# AI_REASONING_STRUCTURED=low         # none | low | medium | high
# AI_REASONING_WRITER=low
# AI_REASONING_CLASSIFIER=none

# ─── Reliability ───
# SHUTDOWN_GRACE_MS=25000             # wait for running analyses on deploy before handing them off
# ANALYSIS_SWEEP_INTERVAL_MS=300000   # how often stuck analyses are recovered
# TWELVELABS_MAX_CONCURRENT_UPLOADS=2 # simultaneous uploads to Twelve Labs (memory bound)

# ─── Monitoring ───
# SENTRY_DSN=                         # Sentry Node project DSN; error tracking is off when empty
# SENTRY_ENVIRONMENT=production
# OPS_ALERT_EMAIL=                    # email for failed analysis/upload alerts + daily summary (via Resend)
# DAILY_SUMMARY_UTC_HOUR=13
