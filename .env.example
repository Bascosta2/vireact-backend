# Secret key for admin data ingestion endpoints — generate a strong random string.
ADMIN_API_KEY=

# Optional: path to yt-dlp binary (default: yt-dlp on PATH). Required for TikTok / YouTube / Instagram URL paste unless using the Docker image.
# YT_DLP_PATH=yt-dlp
# YT_DLP_TIMEOUT_MS=600000
# SOCIAL_VIDEO_MAX_BYTES=209715200

# Mailchimp — powers the /viral-hooks PDF lead-gen funnel.
# Leave MAILCHIMP_ENABLED=false for dev: the /api/subscribe endpoint will log
# submissions to the server console and still redirect users to the thank-you
# page, so the page can be tested end-to-end before creds are wired.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_ENABLED=false
